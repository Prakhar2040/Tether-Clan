{
  "name": "tether-clan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build-lambda.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "drizzle-kit migrate && npm run db:seed"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.1151.0",
    "@fastify/aws-lambda": "^6.4.2",
    "@fastify/cors": "^11.0.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
